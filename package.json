{
  "name": "ai-outfit-guide",
  "private": true,
  "version": "0.1.0",
  "description": "按性别、地区与季节，为一件上衣推荐内搭、裤子、鞋与点缀色的配色指南；含可着色人形预览。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mi4646/ai-outfit-guide.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "outfit",
    "color",
    "fashion",
    "react",
    "vite",
    "tailwindcss",
    "mannequin",
    "color-harmony"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
